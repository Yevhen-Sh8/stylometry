# ── Конфігурація DIMS-сервісу для ІАС (скопіювати в .env і заповнити) ──────

# Драйвер СУБД модуля моніторингу (встановлюється під час збирання образу).
# PostgreSQL: psycopg[binary]>=3.1 | MySQL: pymysql | MS SQL: pyodbc
EXTRA_PIP=psycopg[binary]>=3.1

# Адреса, на якій публікується API (за замовчуванням лише localhost —
# зовнішній доступ через reverse-proxy з TLS).
DIMS_API_BIND=127.0.0.1

# ── API v1 ──────────────────────────────────────────────────────────────────
# Сервісні токени через кому (окремий токен на кожну систему-клієнта).
# Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(32))"
DIMS_SERVICE_TOKENS=
# Токен вебінтерфейсу аналітика (зміни корпусу, запуск аналізу).
DIMS_ADMIN_TOKEN=

# ── Доступ до БД модуля моніторингу ІАС (ЛИШЕ ЧИТАННЯ) ──────────────────────
# Рекомендовано окремого користувача БД з правом SELECT на потрібні таблиці/view.
DIMS_SOURCE_DB_URL=postgresql+psycopg://dims_reader:CHANGE_ME@ias-db:5432/monitoring

# Події, матеріали яких змінено з моменту :since (ISO-8601).
# Обов'язкові колонки: event_id, updated_at. Використовуйте >= (не >):
# повторно прочитані події відсіюються за відбитком складу.
DIMS_SOURCE_CHANGED_EVENTS_SQL=SELECT m.event_id, MAX(m.updated_at) AS updated_at FROM monitoring.materials m WHERE m.updated_at >= CAST(:since AS timestamptz) AND m.event_id IS NOT NULL GROUP BY m.event_id

# Усі матеріали однієї події (:event_id).
# Обов'язкові колонки: source (канал/акаунт/домен), text.
# Опційні: id, platform, domain, url, published_at.
DIMS_SOURCE_EVENT_MATERIALS_SQL=SELECT m.id, s.handle AS source, s.platform, s.domain, m.url, m.published_at, m.text FROM monitoring.materials m JOIN monitoring.sources s ON s.id = m.source_id WHERE m.event_id = :event_id

# ── Сканер ──────────────────────────────────────────────────────────────────
DIMS_SCAN_INTERVAL_S=300
DIMS_SCAN_LOOKBACK_HOURS=24
DIMS_SCAN_MAX_EVENTS=200

# ── Параметри методики (значення як у вебзастосунку) ────────────────────────
DIMS_MFW=100
DIMS_DELTA_THRESHOLD=0.8
DIMS_FEATURE_TYPE=word

# ── Правило сповіщення (ПРОВІЗОРНЕ — калібрується в дослідній експлуатації) ─
DIMS_ALERT_MIN_GRADE=S
DIMS_ALERT_MIN_COORD=0.40
DIMS_ALERT_MIN_COPY_SOURCES=3
DIMS_ALERT_COPY_PASTE_STANDALONE=1

# ── Доставка сповіщень (опційно; без неї — лише через GET /api/v1/alerts) ───
DIMS_ALERT_WEBHOOK_URL=
DIMS_ALERT_WEBHOOK_TOKEN=
# Власний CA-сертифікат відомчої PKI для webhook (шлях у контейнері), опційно.
DIMS_ALERT_WEBHOOK_CA_BUNDLE=
# Зовнішня адреса API — для посилання на сповіщення у webhook.
DIMS_PUBLIC_URL=
